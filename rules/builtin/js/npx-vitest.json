{
  "id": "js/npx-vitest",
  "match": {
    "program": [
      "npx"
    ],
    "argv_prefix": [
      "vitest"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "head_tail"
  },
  "success": {
    "head_lines": 64,
    "tail_lines": 40,
    "max_line_bytes": 16384,
    "max_output_bytes": 65536,
    "min_savings_bytes": 256
  },
  "failure": {
    "head_lines": 500,
    "tail_lines": 200,
    "max_line_bytes": 32768,
    "max_output_bytes": 262144,
    "min_savings_bytes": 256
  }
}
