{
  "id": "gh/run-view",
  "match": {
    "program": [
      "gh"
    ],
    "argv_prefix": [
      "run",
      "view"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "status_summary"
  },
  "success": {
    "max_line_bytes": 32768,
    "max_output_bytes": 704,
    "min_savings_bytes": 512,
    "min_savings_basis_points": 1500
  },
  "failure": {
    "max_line_bytes": 32768,
    "max_output_bytes": 704,
    "min_savings_bytes": 512,
    "min_savings_basis_points": 500
  }
}
