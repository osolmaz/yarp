{
  "id": "rust/cargo-clippy",
  "match": {
    "program": [
      "cargo"
    ],
    "argv_prefix": [
      "clippy"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "line_filter",
    "strip_ansi": true,
    "drop": [
      {
        "kind": "prefix",
        "value": "Compiling ",
        "trim": "start"
      },
      {
        "kind": "prefix",
        "value": "Checking ",
        "trim": "start"
      },
      {
        "kind": "prefix",
        "value": "Fresh ",
        "trim": "start"
      },
      {
        "kind": "prefix",
        "value": "Downloaded ",
        "trim": "start"
      },
      {
        "kind": "prefix",
        "value": "Downloading ",
        "trim": "start"
      }
    ]
  },
  "success": {
    "head_lines": 64,
    "tail_lines": 40,
    "max_line_bytes": 16384,
    "max_output_bytes": 65536,
    "min_savings_bytes": 256
  },
  "failure": {
    "head_lines": 240,
    "tail_lines": 100,
    "max_line_bytes": 32768,
    "max_output_bytes": 196608,
    "min_savings_bytes": 256
  }
}
