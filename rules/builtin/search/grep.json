{
  "id": "search/grep",
  "match": {
    "program": [
      "grep"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "search_summary"
  },
  "success": {
    "max_line_bytes": 32768,
    "max_output_bytes": 704,
    "min_savings_bytes": 256,
    "min_savings_basis_points": 1500
  },
  "failure": {
    "max_line_bytes": 32768,
    "max_output_bytes": 704,
    "min_savings_bytes": 256,
    "min_savings_basis_points": 500
  }
}
