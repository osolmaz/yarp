{
  "id": "git/diff",
  "match": {
    "program": [
      "git"
    ],
    "argv_prefix": [
      "diff"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "git_diff"
  },
  "success": {
    "head_lines": 160,
    "tail_lines": 60,
    "max_line_bytes": 32768,
    "max_output_bytes": 393216,
    "min_savings_bytes": 512
  },
  "failure": {
    "head_lines": 220,
    "tail_lines": 100,
    "max_line_bytes": 32768,
    "max_output_bytes": 524288,
    "min_savings_bytes": 512
  }
}
