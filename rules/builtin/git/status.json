{
  "id": "git/status",
  "match": {
    "program": [
      "git"
    ],
    "argv_prefix": [
      "status"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "git_status"
  },
  "success": {
    "head_lines": 160,
    "tail_lines": 60,
    "max_line_bytes": 16384,
    "max_output_bytes": 98304,
    "min_savings_bytes": 256
  },
  "failure": {
    "head_lines": 200,
    "tail_lines": 80,
    "max_line_bytes": 16384,
    "max_output_bytes": 131072,
    "min_savings_bytes": 256
  }
}
