{
  "id": "git/branch-list",
  "match": {
    "program": [
      "git"
    ],
    "argv_prefix": [
      "branch",
      "--list"
    ]
  },
  "action": "reduce",
  "reducer": {
    "kind": "head_tail"
  },
  "success": {
    "head_lines": 120,
    "tail_lines": 60,
    "max_line_bytes": 32768,
    "max_output_bytes": 98304,
    "min_savings_bytes": 256
  },
  "failure": {
    "head_lines": 160,
    "tail_lines": 80,
    "max_line_bytes": 32768,
    "max_output_bytes": 131072,
    "min_savings_bytes": 256
  }
}
