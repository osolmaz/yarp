{
  "name": "yarp-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Prune command output before it reaches Pi's context",
  "type": "module",
  "scripts": {
    "typecheck:pi": "tsc --noEmit",
    "test:pi": "tsx --test hooks/pi/yarp.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./hooks/pi/yarp.ts"
    ]
  }
}
